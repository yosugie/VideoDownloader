# ─────────────────────────────────────────────────────────────
# Обязательное
# ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ─────────────────────────────────────────────────────────────
# Доступ
# ─────────────────────────────────────────────────────────────
# Список Telegram ID через запятую — кому можно пользоваться ботом.
# Если пусто, бот открыт для всех (не рекомендуется).
# Свой ID можно узнать командой /id у бота.
ALLOWED_USER_IDS=

# ID администраторов: видят технические детали ошибок
# и не подпадают под суточный лимит
ADMIN_IDS=

# Кого не пускать, даже если бот открыт для всех
BLOCKED_USER_IDS=

# Сколько загрузок в сутки разрешено одному человеку.
# 0 — без ограничений. Для открытого бота задайте разумное число.
DAILY_LIMIT_PER_USER=0

# ─────────────────────────────────────────────────────────────
# Лимиты
# ─────────────────────────────────────────────────────────────
# Максимальный размер готового файла в МБ.
# Обычный Bot API разрешает боту отправлять не больше 50 МБ.
MAX_FILE_SIZE_MB=50

# Максимальная длительность ролика в минутах
MAX_DURATION_MINUTES=90

# Потолок качества видео по высоте кадра.
# Осторожно с понижением: у вертикальных роликов (Reels, Shorts,
# TikTok) высота — длинная сторона, и потолок 720 превращает
# кадр 1080x1920 в 405x720, то есть портит их заметно сильнее,
# чем обычное горизонтальное видео.
MAX_VIDEO_HEIGHT=1080

# Сколько загрузок выполнять одновременно
MAX_CONCURRENT_DOWNLOADS=2

# Ниже этого порога свободного места бот перестаёт скачивать, чтобы
# не забить диск до конца — особенно важно, если сервер занят ещё чем-то
MIN_FREE_DISK_MB=2048

# Ограничение скорости скачивания: 5M, 500K и так далее.
# Нужно, когда бот делит канал с чем-то ещё — например с VPN:
# без ограничения одна загрузка забирает всю полосу.
MAX_DOWNLOAD_RATE=

# Минимальная пауза между запросами одного пользователя, сек
RATE_LIMIT_SECONDS=2

# ─────────────────────────────────────────────────────────────
# Загрузка
# ─────────────────────────────────────────────────────────────
# Каталог для временных файлов
DOWNLOAD_DIR=downloads

# Разрешить ссылки на любые сайты, которые поддерживает yt-dlp,
# а не только YouTube / Instagram / TikTok
ALLOW_ANY_SITE=false

# Файл cookies в формате Netscape (нужен для Instagram и части видео YouTube)
COOKIES_FILE=

# Либо брать cookies прямо из браузера: chrome / firefox / edge / safari
COOKIES_FROM_BROWSER=

# HTTP/SOCKS прокси для yt-dlp, например socks5://127.0.0.1:1080
PROXY=

# Особые параметры экстракторов yt-dlp — обходные пути для сервисов,
# которые ломаются не в коде бота. Формат как у --extractor-args:
#   EXTRACTOR_ARGS=tiktok:api_hostname=api22-normal-c-useast2a.tiktokv.com
EXTRACTOR_ARGS=

# Отдельный прокси для связи с api.telegram.org — нужен только если
# Telegram недоступен напрямую
TELEGRAM_PROXY=

# ─────────────────────────────────────────────────────────────
# Прочее
# ─────────────────────────────────────────────────────────────
# Свой Bot API server (позволяет отправлять файлы до 2000 МБ)
# TELEGRAM_API_BASE_URL=http://localhost:8081

LOG_LEVEL=INFO

# Файл учёта загрузок, по нему работает команда /stats
STATS_DB=stats.db

# Сохранять ли в учёте полные ссылки. По умолчанию нет:
# хранятся только сервис, объём и исход.
STATS_STORE_URLS=false

# Сколько секунд ждать завершения отправки файла в Telegram
UPLOAD_TIMEOUT_SECONDS=600
